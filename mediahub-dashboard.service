[Unit]
Description=MEDIAHUB Dashboard - Real-time Monitoring Container
Documentation=https://github.com/your-repo/mon-dashboard
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=unless-stopped
RestartSec=10

# User context
User=docker
Group=docker

# Working directory
WorkingDirectory=/mnt/Data/mon-dashboard

# Load environment variables
EnvironmentFile=/mnt/Data/mon-dashboard/.env
EnvironmentFile=-/etc/default/mediahub-dashboard

# Pre-start checks
ExecStartPre=-/usr/bin/docker compose down
ExecStartPre=/usr/bin/docker compose pull

# Main command - start the dashboard
ExecStart=/usr/bin/docker compose up --no-build --abort-on-container-exit

# Stop command
ExecStop=/usr/bin/docker compose down

# Graceful shutdown timeout (30 seconds)
TimeoutStopSec=30

# Resource limits
MemoryLimit=1G
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/Data/mon-dashboard /var/run/docker.sock

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediahub-dashboard

[Install]
WantedBy=multi-user.target
