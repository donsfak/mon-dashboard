API_HOST=0.0.0.0
DOCKER_SOCK=/var/run/docker.sock
ORANGE_TIMEOUT=5000

# 🔐 IMPORTANT: Get your Tailscale API key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_API_KEY=tskey-api-k2tqdgcEKg11CNTRL-sQkqLoHmqtfBFSLoy5uFufxV4TLRYjg2
TAILSCALE_TAILNET=donsfak.github


# Frontend API endpoint
VITE_API_BASE_URL=http://localhost:3001

# Jellyfin API Configuration
JELLYFIN_URL=http://100.70.128.90:8096
JELLYFIN_API_KEY=e65ff5ebe6164cde8486defc04556975
JELLYFIN_USER_ID=d3c7ef00e80345de8e1906a8a3bfd3f3

# Container management (optional)
ENABLE_PORTAINER=false
PORTAINER_PORT=9000

ENABLE_WATCHTOWER=false

LOG_LEVEL=info
