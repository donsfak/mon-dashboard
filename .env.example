# ============================================
# MEDIAHUB Dashboard Configuration
# ============================================
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control!
# Add .env to .gitignore

# ============================================
# Core Application Settings
# ============================================

# Node environment (production/development)
NODE_ENV=production

# Timezone (affects logs and scheduling)
TZ=Africa/Abidjan

# ============================================
# Dashboard Port Configuration
# ============================================

# Frontend port (Vite dev server / production)
DASHBOARD_PORT=3000

# Backend API port
API_PORT=3001

# ============================================
# Backend API Configuration
# ============================================

# API host (0.0.0.0 for Docker, localhost for local)
API_HOST=0.0.0.0

# Docker socket path (usually /var/run/docker.sock)
DOCKER_SOCK=/var/run/docker.sock

# Network request timeout (milliseconds)
ORANGE_TIMEOUT=5000

# ============================================
# Tailscale Configuration
# ============================================
# Get your API key from: https://login.tailscale.com/admin/settings/keys

# Your Tailscale API Key (keep this secret!)
# Generate at https://login.tailscale.com/admin/settings/keys

# Your Tailscale tailnet (e.g., user@gmail.com)
TAILSCALE_TAILNET=

# ============================================
# Network Monitoring Configuration
# ============================================

# Primary network test server (default: Google DNS - 8.8.8.8)
# Change to any publicly accessible host for latency testing
# Examples: 8.8.8.8 (Google), 1.1.1.1 (Cloudflare), google.com, your-server.com
NETWORK_SERVER_1=8.8.8.8

# Secondary network test server (default: Cloudflare DNS - 1.1.1.1)
# Used as backup if primary is unreachable
NETWORK_SERVER_2=1.1.1.1

# Optional: Custom servers JSON (for advanced configurations)
# Uncomment and modify to use custom servers instead of defaults
# Format: {"server-alias":{"host":"IP_OR_DOMAIN","alias":"alias","label":"Display Name"}}
# CUSTOM_NETWORK_SERVERS={"orange-abidjan":{"host":"185.36.27.18","alias":"abidjan-10g","label":"Abidjan 10G"},"orange-bassam":{"host":"185.36.28.18","alias":"bassam","label":"Bassam"}}

# Network request timeout in milliseconds
ORANGE_TIMEOUT=5000

# ============================================
# Weather Configuration (OpenWeatherMap)
# ============================================
# Get a free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-api-key-here
# Use city name (e.g. "Abobo,CI") OR lat/lon — city name takes priority
WEATHER_CITY=Abobo,CI
WEATHER_LAT=5.3600
WEATHER_LON=-4.0083

# ============================================
# Frontend Configuration
# ============================================

# API base URL (used by React frontend)
# Local development: http://localhost:3001
# Docker: http://localhost:3001 or http://dashboard:3001
VITE_API_BASE_URL=http://localhost:3001

# ============================================
# Jellyfin Configuration
# ============================================

# Jellyfin server URL (including port)
# Get this from your Jellyfin server settings
JELLYFIN_URL=http://your-jellyfin-server:8096

# Jellyfin API Key (keep this secret!)
# Generate in Jellyfin: Settings > Dashboard > API Keys
JELLYFIN_API_KEY=your-api-key-here

# Jellyfin User ID (your user's unique identifier)
# Get your User ID by running:
# curl -s http://YOUR_JELLYFIN_URL:8096/Users?api_key=YOUR_API_KEY | jq '.[] | {Name, Id}'
JELLYFIN_USER_ID=your-user-id-here

# ============================================
# Jellyseerr Configuration
# ============================================

# Jellyseerr server URL (including port)
JELLYSEERR_URL=http://localhost:5055

# Jellyseerr API Key
JELLYSEERR_API_KEY=

# Optional: Filter requests by user
# Use Jellyseerr user id if you want to limit to your requests
JELLYSEERR_USER_ID=

# Optional: Show pending/approved requests (default false = only available)
JELLYSEERR_INCLUDE_PENDING=false

# ============================================
# Arr Stack Update Checks (Optional)
# ============================================

# Sonarr
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Radarr
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Prowlarr
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# ============================================
# Gmail Integration (Optional)
# ============================================
# Format: email:label:refreshToken  (one or more, comma-separated)
# The refresh token is obtained by running: node scripts/gmail-auth.cjs
# Steps:
#   1. Run: node scripts/gmail-auth.cjs
#   2. Open the URL shown, sign in and copy the authorization code
#   3. Paste the code and copy the printed REFRESH TOKEN
#   4. Add it below — repeat for each account
#
# Example (one account):
#   GMAIL_ACCOUNTS=you@gmail.com:Inbox:1//0gXXXXXXXX
# Example (two accounts):
#   GMAIL_ACCOUNTS=you@gmail.com:Inbox:1//0gXXXXXXXX,work@gmail.com:Work:1//0gYYYYYYYY
GMAIL_ACCOUNTS=

# OAuth credentials — copy from the script or your Google Cloud Console app
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# ============================================
# System Resources (Optional)
# ============================================
# Path used for disk usage monitoring (shown in the Resources widget)
# Default: / (root partition)
# Set to /Data if your media lives on a separate mount
DISK_PATH=/

# ============================================
# Container Management (Optional)
# ============================================

# Enable Portainer (optional container management UI)
# Set to true to enable the monitoring profile
ENABLE_PORTAINER=false
PORTAINER_PORT=9000

# Enable Watchtower (automatic container updates)
# Set to true to enable the monitoring profile
ENABLE_WATCHTOWER=false

# ============================================
# Logging Configuration
# ============================================

# Log level (info, debug, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# ============================================
# Security Settings
# ============================================

# API Key for external access (if needed)
API_SECRET_KEY=

# CORS allowed origins (comma-separated)
# For local development: http://localhost:3000,http://localhost:5173
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Advanced Settings
# ============================================

# Cache TTL for Docker data (milliseconds)
DOCKER_CACHE_TTL=5000

# Cache TTL for Tailscale data (milliseconds)
TAILSCALE_CACHE_TTL=5000

# Cache TTL for network ping data (milliseconds)
NETWORK_CACHE_TTL=10000

# Polling interval for real-time updates (milliseconds)
POLLING_INTERVAL=5000
